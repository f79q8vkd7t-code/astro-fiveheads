---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ShowList from "../components/ShowList.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../config/site";
import { shows } from "../data/shows";

const gallery = import.meta.glob("../assets/gallery/*.{jpg,jpeg,png,webp,avif}", { eager: true });
const imgs = Object.values(gallery).map((m) => m.default).filter(Boolean);
imgs.sort((a, b) => (b.src || "").localeCompare(a.src || ""));
const preview = imgs.slice(0, 12);

const now = new Date();
const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
const nextShow = [...shows]
  .filter((s) => s.date >= todayIso)
  .sort((a, b) => a.date.localeCompare(b.date))[0];

const tags = ["Party", "Charts", "Rock", "Pop"];

const aboutText =
  "Wir sind FIVEHEADS, Live-Coverband aus Bad Tölz und dem Oberland. Wir spielen Party, Charts, Rock und Pop — vom entspannten Akustik-Set beim Empfang bis zum Party-Set für die volle Tanzfläche. Ob Hochzeit, Firmenfeier, Geburtstag oder Stadtfest: Wir stimmen unser Set auf euren Abend ab. Die komplette Songliste schicken wir euch gern auf Anfrage.";

const occasions = [
  {
    title: "Hochzeit",
    copy: "Vom ersten Tanz bis zur letzten Zugabe — wir begleiten euren Tag mit dem passenden Sound."
  },
  {
    title: "Firmenfeier",
    copy: "Sommerfest, Weihnachtsfeier oder Jubiläum: Livemusik, die Kolleginnen und Kollegen auf die Tanzfläche bringt."
  },
  {
    title: "Geburtstag",
    copy: "Runde Geburtstage und private Feiern — mit Songs, die alle Generationen mitsingen können."
  },
  {
    title: "Stadt- & Vereinsfest",
    copy: "Open-Air-erprobt und flexibel: Wir spielen Feste, Festzelte und Bühnen jeder Größe."
  },
  {
    title: "Bar & Club",
    copy: "Ein Abend voller Cover, die das Publikum kennt — direkt, laut und nah dran."
  }
];

// TODO(Alex): Platzhalter-Werte — Besetzung, Set-Längen und Technik ergänzen/anpassen.
const bookingFacts = [
  { label: "Besetzung", value: "5 Musiker:innen — Angabe folgt" },
  { label: "Set-Längen", value: "z. B. 2 × 60 min oder 3 × 45 min — Angabe folgt" },
  { label: "PA & Licht", value: "Angabe folgt" }
];

const bookingMail = `mailto:${site.contactEmail}?subject=${encodeURIComponent(
  "Booking-Anfrage FIVEHEADS"
)}&body=${encodeURIComponent(
  "Hallo FIVEHEADS,\n\nwir möchten euch gern anfragen:\n\nDatum:\nOrt:\nAnlass:\nGästezahl (ca.):\n\nViele Grüße\n"
)}`;

const bandStructuredData = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: site.bandName,
  url: site.siteUrl,
  genre: ["Cover", "Party", "Pop", "Rock"],
  email: site.contactEmail,
  areaServed: "Bad Tölz und Oberland, Bayern",
  sameAs: [site.links.instagram, site.links.tiktok]
};

const fmtShowDate = (iso) =>
  new Intl.DateTimeFormat("de-DE", { day: "2-digit", month: "2-digit", year: "numeric" }).format(
    new Date(iso + "T00:00:00")
  );
---
<BaseLayout title={`${site.bandName} — Coverband für Events`}>
  <script type="application/ld+json" set:html={JSON.stringify(bandStructuredData)} />
  <Nav />

  <!-- BIG HERO (full-bleed) -->
  <header class="heroFull">
    <img src="/hero.jpg" alt={`${site.bandName} live`} loading="eager" />
    <div class="overlay">
      <h1 class="heroStack" aria-label={site.bandName}>
        <span class="heroLine heroLineTop">{site.bandName}</span>
        <span class="heroLine heroLineMid">{site.bandName}</span>
        <span class="heroLine heroLineBot">{site.bandName}</span>
      </h1>

      <p class="heroClaim">
        Live-Coverband aus dem Oberland — für Hochzeiten, Firmenfeiern und Feste.
      </p>

      <div class="heroBadges">
        <span class="badge hot">Jetzt buchbar</span>
        {nextShow ? (
          <span class="badge nextShowBadge">{fmtShowDate(nextShow.date)} · {nextShow.venue} {nextShow.city}</span>
        ) : (
          <span class="badge">Termine auf Anfrage</span>
        )}
      </div>

      <div class="heroActions">
        <a class="btn primary big" href={bookingMail}>Termin anfragen</a>
        <a class="btn big" href="/#anlaesse">Für welche Anlässe</a>
      </div>
    </div>
  </header>

  <PhotoStrip />

  <main>
    <!-- About -->
    <section id="about" class="section sectionAbout">
      <div class="container">
        <h2 class="h2">Über uns</h2>
        <div class="card aboutCard">
          <div class="aboutCopy">
            <div class="musicEyebrow">Coverband für Events</div>
            <p class="p aboutCopyText">{aboutText}</p>

            <div class="aboutPills">
              {tags.map((t) => (
                <span class="pill">{t}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Anlässe -->
    <section id="anlaesse" class="section">
      <div class="container">
        <h2 class="h2">Für welche Anlässe</h2>

        <div class="occasionGrid">
          {occasions.map((o) => (
            <div class="card occasionCard">
              <h3 class="occasionTitle">{o.title}</h3>
              <p class="p occasionCopy">{o.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Live -->
    <section id="live" class="section">
      <div class="container">
        <h2 class="h2">Auftritte</h2>
        <ShowList />
      </div>
    </section>

    <!-- Booking -->
    <section id="booking" class="section">
      <div class="container">
        <h2 class="h2">Booking & Kontakt</h2>

        <div class="card" style="padding:18px;">
          <div class="bookingFacts">
            {bookingFacts.map((f) => (
              <div class="bookingFact">
                <div class="small">{f.label}</div>
                <div class="bookingFactValue">{f.value}</div>
              </div>
            ))}
          </div>

          <div class="hr"></div>

          <p class="p" style="max-width:62ch;">
            Schreibt uns für ein schnelles Angebot am besten direkt <strong>Datum, Ort und Anlass</strong> eurer
            Veranstaltung — wir melden uns kurzfristig zurück.
          </p>

          <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
            <!--email_off--><a class="btn primary big" href={bookingMail}>{site.contactEmail}</a><!--/email_off-->
          </div>

          <div class="hr"></div>

          <div class="small">Social</div>
          <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
            <a class="btn big" href={site.links.instagram} target="_blank" rel="me noopener">Instagram</a>
            <a class="btn big" href={site.links.tiktok} target="_blank" rel="me noopener">TikTok</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Photos -->
    <section class="section">
      <div class="container">
        <h2 class="h2">Fotos</h2>

        {preview.length ? (
          <>
            <div class="photoGrid" id="homeGrid">
              {preview.map((img) => (
                <button class="photoItem" type="button" data-full={img.src} aria-label="Foto öffnen">
                  <img src={img.src} alt="Live Foto" loading="lazy" />
                </button>
              ))}
            </div>

            <dialog class="modal" id="homeModal">
              <div class="inner">
                <header>
                  <div class="small">Live Foto</div>
                  <button type="button" id="homeClose">Schließen</button>
                </header>
                <img id="homeModalImg" src="" alt="Live Foto groß" />
              </div>
            </dialog>

            <script is:inline>
              (function () {
                function initHomeModal() {
                  var homeGrid = document.getElementById("homeGrid");
                  var homeModal = document.getElementById("homeModal");
                  var homeModalImg = document.getElementById("homeModalImg");
                  var homeCloseBtn = document.getElementById("homeClose");
                  if (!homeGrid || !homeModal || !homeModalImg) return;

                  var previousCleanup = window.__fiveheadsHomeGalleryCleanup;
                  if (typeof previousCleanup === "function") previousCleanup();
                  var cleanups = [];
                  function on(target, type, handler) {
                    target.addEventListener(type, handler);
                    cleanups.push(function () { target.removeEventListener(type, handler); });
                  }

                  function setHomeModalOpen(isOpen) {
                    if (isOpen) {
                      homeModal.classList.add("is-open");
                      homeModal.setAttribute("open", "");
                      if (typeof homeModal.showModal === "function" && !homeModal.open) {
                        try { homeModal.showModal(); } catch (_) {}
                      }
                      document.body.style.overflow = "hidden";
                      return;
                    }

                    homeModal.classList.remove("is-open");
                    if (typeof homeModal.close === "function" && homeModal.open) {
                      try { homeModal.close(); } catch (_) {}
                    }
                    homeModal.removeAttribute("open");
                    document.body.style.overflow = "";
                  }

                  function openHomeModal(src) {
                    if (!src) return;
                    homeModalImg.src = src;
                    setHomeModalOpen(true);
                  }

                  function closeHomeModal() {
                    setHomeModalOpen(false);
                    homeModalImg.src = "";
                  }

                  on(homeGrid, "click", function (e) {
                    var target = e.target;
                    if (!(target instanceof Element)) return;
                    var btn = target.closest("button[data-full]");
                    if (!btn) return;
                    var src = btn.getAttribute("data-full");
                    if (src) openHomeModal(src);
                  });

                  if (homeCloseBtn) on(homeCloseBtn, "click", closeHomeModal);
                  on(homeModal, "click", function (e) {
                    if (e.target === homeModal) closeHomeModal();
                  });
                  on(window, "keydown", function (e) {
                    if (e.key === "Escape") closeHomeModal();
                  });

                  window.__fiveheadsHomeGalleryCleanup = function () {
                    for (var i = 0; i < cleanups.length; i++) cleanups[i]();
                  };
                }

                initHomeModal();
                document.addEventListener("astro:page-load", initHomeModal);
              })();
            </script>
          </>
        ) : (
          <div class="card" style="padding:18px;">
            <p class="p">Lege Fotos in <code>src/assets/gallery/</code> ab (z.B. .jpg). Dann erscheinen sie hier automatisch.</p>
          </div>
        )}

        <div style="margin-top:16px;">
          <a class="btn primary" href="/gallery">Zur Galerie</a>
        </div>
      </div>
    </section>

    <!-- Video -->
    <section id="video" class="section">
      <div class="container">
        <h2 class="h2">Live-Eindruck</h2>

        <!--
          TODO(Alex): Sobald ein Live-Cover-Video da ist, den Platzhalter unten
          durch das Embed ersetzen (VIDEO_ID austauschen):

          <div class="card" style="padding:0; overflow:hidden;">
            <iframe
              width="560"
              height="315"
              src="https://www.youtube.com/embed/VIDEO_ID"
              title="FIVEHEADS live (Cover)"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              style="display:block; width:100%; aspect-ratio:16/9;"
            ></iframe>
          </div>
        -->
        <div class="card videoPlaceholder">
          <div class="videoPlaceholderInner">
            <div class="small">Video folgt</div>
            <p class="p">Hier zeigen wir bald einen Live-Mitschnitt von uns — bis dahin: Fotos oben ansehen oder direkt anfragen.</p>
            <a class="btn primary" href={bookingMail}>Termin anfragen</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
