---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../config/site";
import { currentSingle } from "../data/releases";

const singleJsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  name: currentSingle.title,
  byArtist: {
    "@type": "MusicGroup",
    name: site.bandName
  },
  datePublished: currentSingle.releaseDate,
  url: `${site.siteUrl}${currentSingle.slug}`,
  image: `${site.siteUrl}${currentSingle.cover.replace(/^\//, "")}`,
  sameAs: [currentSingle.spotifyUrl, currentSingle.appleMusicUrl, currentSingle.tuneCoreUrl]
};

const streamingItems = [
  { label: "Spotify", href: currentSingle.spotifyUrl },
  { label: "Apple Music", href: currentSingle.appleMusicUrl },
  { label: "YouTube", href: currentSingle.youtubeUrl },
  { label: "Amazon Music", href: currentSingle.amazonMusicUrl },
  { label: "Alle Plattformen", href: currentSingle.tuneCoreUrl }
];
---
<BaseLayout title={`${site.bandName} — ${currentSingle.title}`} description={currentSingle.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(singleJsonLd)} />

  <header class="singleTopbar">
    <div class="container singleTopbarRow">
      <a class="singleTopbarBrand" href="/">{site.bandName}</a>
      <nav class="singleTopbarNav" aria-label="Single Navigation">
        <a href="/#music">Musik</a>
        <a href={site.links.instagram} target="_blank" rel="me noopener">Instagram</a>
        <a href="/#contact">Kontakt</a>
      </nav>
    </div>
  </header>

  <main class="section sectionPage pageSingle">
    <div class="container singleLanding">
      <section class="card singleLandingHero">
        <div class="singleLandingCopy">
          <div class="releaseKick">New Single</div>
          <h1 class="singlePageTitle">{currentSingle.title}</h1>
          <div class="singleLandingMeta">Out now · {currentSingle.releaseLabel}</div>
          <p class="p releaseLead">{currentSingle.shortCopy}</p>

          <div class="releaseActions">
            <a class="btn primary big" href={currentSingle.spotifyUrl} target="_blank" rel="noopener">Jetzt hören</a>
            <a class="btn big" href={currentSingle.tuneCoreUrl} target="_blank" rel="noopener">Alle Plattformen</a>
          </div>
        </div>

        <div class="singleLandingCover">
          <img src={currentSingle.cover} alt={`Cover von ${currentSingle.title}`} loading="eager" />
        </div>
      </section>

      <section class="card singleStreamingCard">
        <div class="small">Streaming links</div>
        <div class="singleStreamingGrid">
          {streamingItems.map((item) =>
            item.href ? (
              <a class="btn big" href={item.href} target="_blank" rel="noopener">{item.label}</a>
            ) : (
              <span class="btn big is-disabled" aria-disabled="true">{item.label}</span>
            )
          )}
        </div>
      </section>

      <section class="card singleStoryCard">
        <div class="small">Über den Song</div>
        <p class="p singleStoryCopy">{currentSingle.aboutSong}</p>
      </section>
    </div>
  </main>

  <SiteFooter note={`${site.bandName} · ${currentSingle.title} · 2026`} />
</BaseLayout>
