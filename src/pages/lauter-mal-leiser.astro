---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../config/site";
import { currentSingle } from "../data/releases";

const singleJsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  name: currentSingle.title,
  byArtist: {
    "@type": "MusicGroup",
    name: site.bandName
  },
  datePublished: currentSingle.releaseDate,
  url: `${site.siteUrl}${currentSingle.slug}`,
  image: `${site.siteUrl}${currentSingle.cover.replace(/^\//, "")}`,
  sameAs: [currentSingle.spotifyUrl, currentSingle.appleMusicUrl, currentSingle.tuneCoreUrl]
};
---
<BaseLayout title={`${site.bandName} — ${currentSingle.title}`} description={currentSingle.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(singleJsonLd)} />
  <Nav />

  <main class="section sectionPage pageSingle">
    <div class="container">
      <div class="singlePageHero">
        <div class="singlePageCopy">
          <div class="releaseKick">Out now</div>
          <h1 class="singlePageTitle">{currentSingle.title}</h1>
          <p class="p releaseLead">{currentSingle.shortCopy}</p>
          <p class="p releaseBody">{currentSingle.bodyCopy}</p>

          <div class="releaseMeta">
            <span class="releaseMetaPill">FIVEHEADS</span>
            <span class="releaseMetaPill">Single</span>
            <span class="releaseMetaPill">{currentSingle.releaseLabel}</span>
          </div>

          <div class="releaseActions">
            <a class="btn primary big" href={currentSingle.spotifyUrl} target="_blank" rel="noopener">Spotify</a>
            <a class="btn big" href={currentSingle.appleMusicUrl} target="_blank" rel="noopener">Apple Music</a>
            <a class="btn big" href={currentSingle.tuneCoreUrl} target="_blank" rel="noopener">Alle Plattformen</a>
          </div>
        </div>

        <div class="singlePageCover">
          <img src={currentSingle.cover} alt={`Cover von ${currentSingle.title}`} loading="eager" />
        </div>
      </div>

      <div class="singlePageGrid">
        <div class="card singlePagePlayerCard">
          <div class="small">Listen now</div>
          <iframe
            class="releaseEmbedFrame releaseEmbedFrameLarge"
            src={currentSingle.spotifyEmbedUrl}
            width="100%"
            height="352"
            frameBorder="0"
            allowfullscreen=""
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title={`Spotify Player für ${currentSingle.title}`}
          ></iframe>
        </div>

        <div class="card singlePageInfoCard">
          <div class="small">Release info</div>
          <div class="singleInfoList">
            <div class="singleInfoRow">
              <span class="small">Titel</span>
              <strong>{currentSingle.title}</strong>
            </div>
            <div class="singleInfoRow">
              <span class="small">Artist</span>
              <strong>{site.bandName}</strong>
            </div>
            <div class="singleInfoRow">
              <span class="small">Released</span>
              <strong>{currentSingle.releaseLabel}</strong>
            </div>
            <div class="singleInfoRow">
              <span class="small">Link hub</span>
              <a href={currentSingle.tuneCoreUrl} target="_blank" rel="noopener">TuneCore Sharelink</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
